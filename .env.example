# Copy this file to .env.local and change the values before going live.

# Admin panel login (used by /admin/login)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me-to-a-strong-password

# Secret used to sign admin session tokens.
# Generate one with:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ADMIN_SECRET=change-this-to-a-random-string-in-production

# Sentry error monitoring (optional — leave unset to disable).
# Server/edge errors use SENTRY_DSN; browser errors need NEXT_PUBLIC_SENTRY_DSN.
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
